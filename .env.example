# ============================================
# Calculator12.com - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
# cp .env.example .env
# ============================================

# --------------------------------------------
# SERVER CONFIGURATION
# --------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api
API_VERSION=v1

# --------------------------------------------
# DATABASE CONFIGURATION (Future Use)
# --------------------------------------------
# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=calculator12
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# PostgreSQL (Alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=calculator12
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password_here

# MongoDB (Alternative)
# MONGODB_URI=mongodb://localhost:27017/calculator12

# --------------------------------------------
# SECURITY
# --------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CSRF_SECRET=your_csrf_secret_here
SESSION_SECRET=your_session_secret_here

# --------------------------------------------
# CORS CONFIGURATION
# --------------------------------------------
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# TRANSLATION API (Future Use)
# --------------------------------------------
# Google Translate API
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# DeepL API (Alternative)
DEEPL_API_KEY=your_deepl_api_key_here

# --------------------------------------------
# AI API (Future Use)
# --------------------------------------------
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --------------------------------------------
# EMAIL (Future Use - Newsletter)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@calculator12.com

# --------------------------------------------
# ANALYTICS
# --------------------------------------------
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# --------------------------------------------
# SEO & SITEMAP
# --------------------------------------------
SITE_URL=https://calculator12.com
SITE_NAME=Calculator12
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,fr,es,de,pt,zh,ja,ar,ru

# --------------------------------------------
# CACHE CONFIGURATION
# --------------------------------------------
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# --------------------------------------------
# FILE UPLOAD (Future Use)
# --------------------------------------------
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./public/uploads

# --------------------------------------------
# LOGGING
# --------------------------------------------
LOG_LEVEL=info
LOG_DIR=./server/logs

# --------------------------------------------
# ADMIN PANEL (Future Use)
# --------------------------------------------
ADMIN_EMAIL=admin@calculator12.com
ADMIN_DEFAULT_PASSWORD=change_this_immediately