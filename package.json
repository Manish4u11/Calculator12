{
  "name": "calculator12",
  "version": "1.0.0",
  "description": "Calculator12.com - Enterprise-grade static calculator platform with multi-language SEO architecture.",
  "main": "public/index.html",
  "scripts": {
    "translate": "node build/auto-translate.js",
    "build": "npm run translate && node build/generate-calculators.js",
    "start": "npx serve public -p 3000",
    "clean": "rimraf public/calculators/**/*.html",
    "format": "prettier --write \"**/*.{js,html,json,css}\"",
    "lint": "echo 'Linting will be configured in Phase 2'"
  },
  "keywords": [
    "calculator",
    "finance",
    "health",
    "math",
    "conversion",
    "multilingual",
    "seo",
    "glassmorphism",
    "static-site"
  ],
  "author": "Calculator12 Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "serve": "^14.2.3"
  }
}
